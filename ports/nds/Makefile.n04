# N04 strict-C11 bounded package reader and separate ARM9 FAT probe.
BLOCKSDS ?= /opt/blocksds/core
WONDERFUL_TOOLCHAIN ?= /opt/wonderful
ARM_NONE_EABI_PATH ?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/
ARM7ELF ?= $(BLOCKSDS)/sys/arm7/main_core/arm7_maxmod.elf
OUTDIR := ../../build/nds/n04
OBJDIR := $(OUTDIR)/obj
NAME := dok_nds_assets
ELF := $(OUTDIR)/$(NAME).elf
MAP := $(OUTDIR)/$(NAME).map
ROM := $(OUTDIR)/$(NAME).nds
OBJECTS := $(OBJDIR)/main.o $(OBJDIR)/file_reader.o $(OBJDIR)/assets.o $(OBJDIR)/sha256.o
COMPILE_CHECKS := $(OBJDIR)/test_assets.o $(OBJDIR)/assets_compile.o
CC := $(ARM_NONE_EABI_PATH)arm-none-eabi-gcc
NDSTOOL := $(BLOCKSDS)/tools/ndstool/ndstool
ARCH := -mthumb -mcpu=arm946e-s+nofp
SPECS := $(BLOCKSDS)/sys/crts/ds_arm9.specs
CPPFLAGS := -D__NDS__ -D__BLOCKSDS__ -DARM9 -Iinclude
CFLAGS := -Og -g3 -Wall -Wextra -Werror -ffunction-sections -fdata-sections
CORE_CFLAGS := -std=c11 -pedantic-errors $(CFLAGS)
PLATFORM_CPPFLAGS := $(CPPFLAGS) -I$(BLOCKSDS)/libs/libnds/include
LDFLAGS := -L$(BLOCKSDS)/libs/libnds/lib -Wl,-Map,$(MAP) -Wl,--defsym=__usr_stack_size=12288
.PHONY: all
all: $(ROM) $(COMPILE_CHECKS)
$(ROM): $(ELF) $(ARM7ELF)
	"$(NDSTOOL)" -c "$@" -9 "$(ELF)" -7 "$(ARM7ELF)"
$(ELF): $(OBJECTS)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) -o "$@" $(OBJECTS) $(LDFLAGS) -Wl,--start-group -lnds9 -lc -Wl,--end-group
$(OBJDIR)/main.o: platform/assets/main.c platform/assets/assets_probe.h platform/assets/file_reader.h include/dok/assets.h include/dok/sha256.h include/dok/memory_budget.h Makefile.n04 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(PLATFORM_CPPFLAGS) -std=gnu11 $(CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/file_reader.o: platform/assets/file_reader.c platform/assets/file_reader.h include/dok/assets.h Makefile.n04 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(PLATFORM_CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/assets.o: core/assets.c include/dok/assets.h include/dok/sha256.h Makefile.n04 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/sha256.o: core/sha256.c include/dok/sha256.h Makefile.n04 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/test_assets.o: tests/test_assets.c include/dok/assets.h include/dok/sha256.h Makefile.n04 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/assets_compile.o: tests/assets_compile.c include/dok/assets.h include/dok/sha256.h Makefile.n04 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR):
	mkdir -p "$@"
-include $(OBJECTS:.o=.d) $(COMPILE_CHECKS:.o=.d)
