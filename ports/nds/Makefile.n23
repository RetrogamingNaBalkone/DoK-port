# Full N22 game with independently selectable diagnostic timing.
OUTDIR ?= ../../build/nds/n23/candidate-ru
include Makefile.n22
N23_CAPTURE_HOLD ?= 0
CPPFLAGS += -DN23_CAPTURE_HOLD=$(N23_CAPTURE_HOLD)
PLATFORM_CPPFLAGS += -DN23_CAPTURE_HOLD=$(N23_CAPTURE_HOLD)
# One self-contained production ROM; SCN/legacy controls retain FAT fixtures.
NDS_EMBEDDED_RESOURCES ?= $(GAMEPLAY_FRONTEND)
CPPFLAGS += -DNDS_EMBEDDED_RESOURCES=$(NDS_EMBEDDED_RESOURCES)
PLATFORM_CPPFLAGS += -DNDS_EMBEDDED_RESOURCES=$(NDS_EMBEDDED_RESOURCES)
ifeq ($(NDS_EMBEDDED_RESOURCES),1)
OBJECTS += $(OBJDIR)/input_bridge.o
$(ELF): $(OBJDIR)/input_bridge.o
LDFLAGS += -Wl,--wrap=scanKeys
$(OBJDIR)/input_bridge.o: platform/audio/input_bridge.c platform/audio/audio_ipc.h | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(PLATFORM_CPPFLAGS) -std=gnu11 $(CFLAGS) -MMD -MP -c "$<" -o "$@"
NITROFSDIR := $(OUTDIR)/nitrofs
$(ROM): $(NITROFSDIR)/dok/assets.ndp $(NITROFSDIR)/dok/ui.dat $(NITROFSDIR)/dok/frontend.dat $(NITROFSDIR)/dok/frames.dat $(NITROFSDIR)/dok/sounds.dat
$(NITROFSDIR)/dok:
	mkdir -p "$@"
$(NITROFSDIR)/dok/assets.ndp: ../../build/nds/assets/dok-assets.ndspak | $(NITROFSDIR)/dok
	cp "$<" "$@"
$(NITROFSDIR)/dok/ui.dat: ../../build/nds/n23/playtest-ui/ui.dat | $(NITROFSDIR)/dok
	cp "$<" "$@"
$(NITROFSDIR)/dok/frontend.dat: ../../build/nds/n21/frontend.dat | $(NITROFSDIR)/dok
	cp "$<" "$@"
endif
N23_FINE_PROFILE ?= 0
N23_RELATIVE_MATRICES ?= 0
CPPFLAGS += -DN23_RELATIVE_MATRICES=$(N23_RELATIVE_MATRICES)
PLATFORM_CPPFLAGS += -DN23_RELATIVE_MATRICES=$(N23_RELATIVE_MATRICES)
N23_SIMPLE_QUADS ?= 0
CPPFLAGS += -DN23_SIMPLE_QUADS=$(N23_SIMPLE_QUADS)
PLATFORM_CPPFLAGS += -DN23_SIMPLE_QUADS=$(N23_SIMPLE_QUADS)
N23_STATIC_GEOMETRY ?= 0
CPPFLAGS += -DN23_STATIC_GEOMETRY=$(N23_STATIC_GEOMETRY)
PLATFORM_CPPFLAGS += -DN23_STATIC_GEOMETRY=$(N23_STATIC_GEOMETRY)
ifeq ($(N23_STATIC_GEOMETRY),1)
OBJECTS += $(OBJDIR)/static_geometry.o
$(ELF): $(OBJDIR)/static_geometry.o
$(OBJDIR)/static_geometry.o: ARCH := -marm -mcpu=arm946e-s+nofp
-include $(OBJDIR)/static_geometry.d
endif
N23_PIPELINE_PROFILE ?= 0
CPPFLAGS += -DN23_PIPELINE_PROFILE=$(N23_PIPELINE_PROFILE)
PLATFORM_CPPFLAGS += -DN23_PIPELINE_PROFILE=$(N23_PIPELINE_PROFILE)
N23_BATCH_EVICTION ?= 0
N23_NATIVE_DIV480 ?= 0
N23_NATIVE_ARM ?= 0
N23_CACHE_BENCH ?= 0
N23_MAP_VERTICAL ?= 0
N23_COLLISION_CORNERS ?= 0
N23_FRAME_BATCH ?= 0
N23_CACHE_BENCH_GROUP ?= 1
N23_CLIP_CACHE ?= 0
N23_CLOCK_FAST32 ?= 0
N23_CLOCK_BENCH ?= 0
N23_FUSED_CULL ?= 0
N23_MAP_BENCH ?= 0
N23_MAP_FINE ?= 0
N23_MAP_DIRECT_SEEN ?= 0
CPPFLAGS += -DN23_MAP_DIRECT_SEEN=$(N23_MAP_DIRECT_SEEN)
PLATFORM_CPPFLAGS += -DN23_MAP_DIRECT_SEEN=$(N23_MAP_DIRECT_SEEN)
N23_HUD_FULL_DMA ?= 0
CPPFLAGS += -DN23_HUD_FULL_DMA=$(N23_HUD_FULL_DMA)
PLATFORM_CPPFLAGS += -DN23_HUD_FULL_DMA=$(N23_HUD_FULL_DMA)
N23_MAP_SECTOR_DIRTY ?= 0
CPPFLAGS += -DN23_MAP_SECTOR_DIRTY=$(N23_MAP_SECTOR_DIRTY)
PLATFORM_CPPFLAGS += -DN23_MAP_SECTOR_DIRTY=$(N23_MAP_SECTOR_DIRTY)
CPPFLAGS += -DN23_MAP_FINE=$(N23_MAP_FINE)
PLATFORM_CPPFLAGS += -DN23_MAP_FINE=$(N23_MAP_FINE)
N23_DOOR_INPLACE ?= 0
N23_EFFECT_POOL_WORKSET ?= 0
N23_CODEC_SMALL ?= 0
N23_CODEC_BENCH ?= 0
N23_DISCOVERY_CACHE ?= 0
N23_DISCOVERY_BITSET ?= 0
N23_DISCOVERY_SORT ?= 0
CPPFLAGS += -DN23_DISCOVERY_SORT=$(N23_DISCOVERY_SORT)
PLATFORM_CPPFLAGS += -DN23_DISCOVERY_SORT=$(N23_DISCOVERY_SORT)
CPPFLAGS += -DN23_DISCOVERY_BITSET=$(N23_DISCOVERY_BITSET)
PLATFORM_CPPFLAGS += -DN23_DISCOVERY_BITSET=$(N23_DISCOVERY_BITSET)
N23_MAP_BUTTON_CACHE ?= 0
N23_COMPACT_SOURCE ?= 0
N23_COLLISION_OBJECT ?= 0
N23_OVERLAY_REUSE ?= 0
N23_OVERLAY_REUSE_RAW ?= 0
CPPFLAGS += -DN23_OVERLAY_REUSE_RAW=$(N23_OVERLAY_REUSE_RAW)
PLATFORM_CPPFLAGS += -DN23_OVERLAY_REUSE_RAW=$(N23_OVERLAY_REUSE_RAW)
N23_COMBAT_SAR ?= 0
N23_CACHE_REPLACE ?= 0
CPPFLAGS += -DN23_CACHE_REPLACE=$(N23_CACHE_REPLACE)
PLATFORM_CPPFLAGS += -DN23_CACHE_REPLACE=$(N23_CACHE_REPLACE)
CPPFLAGS += -DN23_COMBAT_SAR=$(N23_COMBAT_SAR)
PLATFORM_CPPFLAGS += -DN23_COMBAT_SAR=$(N23_COMBAT_SAR)
CPPFLAGS += -DN23_OVERLAY_REUSE=$(N23_OVERLAY_REUSE)
PLATFORM_CPPFLAGS += -DN23_OVERLAY_REUSE=$(N23_OVERLAY_REUSE)
CPPFLAGS += -DN23_COLLISION_OBJECT=$(N23_COLLISION_OBJECT)
PLATFORM_CPPFLAGS += -DN23_COLLISION_OBJECT=$(N23_COLLISION_OBJECT)
CPPFLAGS += -DN23_COMPACT_SOURCE=$(N23_COMPACT_SOURCE)
PLATFORM_CPPFLAGS += -DN23_COMPACT_SOURCE=$(N23_COMPACT_SOURCE)
CPPFLAGS += -DN23_MAP_BUTTON_CACHE=$(N23_MAP_BUTTON_CACHE)
PLATFORM_CPPFLAGS += -DN23_MAP_BUTTON_CACHE=$(N23_MAP_BUTTON_CACHE)
CPPFLAGS += -DN23_DISCOVERY_CACHE=$(N23_DISCOVERY_CACHE)
PLATFORM_CPPFLAGS += -DN23_DISCOVERY_CACHE=$(N23_DISCOVERY_CACHE)
CPPFLAGS += -DN23_CODEC_SMALL=$(N23_CODEC_SMALL) -DN23_CODEC_BENCH=$(N23_CODEC_BENCH)
PLATFORM_CPPFLAGS += -DN23_CODEC_SMALL=$(N23_CODEC_SMALL) -DN23_CODEC_BENCH=$(N23_CODEC_BENCH)
CPPFLAGS += -DN23_FINE_PROFILE=$(N23_FINE_PROFILE) -DN23_BATCH_EVICTION=$(N23_BATCH_EVICTION)
PLATFORM_CPPFLAGS += -DN23_FINE_PROFILE=$(N23_FINE_PROFILE) -DN23_BATCH_EVICTION=$(N23_BATCH_EVICTION)
CPPFLAGS += -DN23_NATIVE_DIV480=$(N23_NATIVE_DIV480)
PLATFORM_CPPFLAGS += -DN23_NATIVE_DIV480=$(N23_NATIVE_DIV480)
CPPFLAGS += -DN23_CACHE_BENCH=$(N23_CACHE_BENCH)
PLATFORM_CPPFLAGS += -DN23_CACHE_BENCH=$(N23_CACHE_BENCH)
CPPFLAGS += -DN23_MAP_VERTICAL=$(N23_MAP_VERTICAL)
PLATFORM_CPPFLAGS += -DN23_MAP_VERTICAL=$(N23_MAP_VERTICAL)
CPPFLAGS += -DN23_COLLISION_CORNERS=$(N23_COLLISION_CORNERS)
PLATFORM_CPPFLAGS += -DN23_COLLISION_CORNERS=$(N23_COLLISION_CORNERS)
CPPFLAGS += -DN23_FRAME_BATCH=$(N23_FRAME_BATCH)
PLATFORM_CPPFLAGS += -DN23_FRAME_BATCH=$(N23_FRAME_BATCH)
CPPFLAGS += -DN23_CACHE_BENCH_GROUP=$(N23_CACHE_BENCH_GROUP)
PLATFORM_CPPFLAGS += -DN23_CACHE_BENCH_GROUP=$(N23_CACHE_BENCH_GROUP)
CPPFLAGS += -DN23_CLIP_CACHE=$(N23_CLIP_CACHE)
PLATFORM_CPPFLAGS += -DN23_CLIP_CACHE=$(N23_CLIP_CACHE)
CPPFLAGS += -DN23_CLOCK_FAST32=$(N23_CLOCK_FAST32) -DN23_CLOCK_BENCH=$(N23_CLOCK_BENCH)
PLATFORM_CPPFLAGS += -DN23_CLOCK_FAST32=$(N23_CLOCK_FAST32) -DN23_CLOCK_BENCH=$(N23_CLOCK_BENCH)
CPPFLAGS += -DN23_FUSED_CULL=$(N23_FUSED_CULL)
PLATFORM_CPPFLAGS += -DN23_FUSED_CULL=$(N23_FUSED_CULL)
CPPFLAGS += -DN23_MAP_BENCH=$(N23_MAP_BENCH)
PLATFORM_CPPFLAGS += -DN23_MAP_BENCH=$(N23_MAP_BENCH)
CPPFLAGS += -DN23_DOOR_INPLACE=$(N23_DOOR_INPLACE)
PLATFORM_CPPFLAGS += -DN23_DOOR_INPLACE=$(N23_DOOR_INPLACE)
CPPFLAGS += -DN23_EFFECT_POOL_WORKSET=$(N23_EFFECT_POOL_WORKSET)
PLATFORM_CPPFLAGS += -DN23_EFFECT_POOL_WORKSET=$(N23_EFFECT_POOL_WORKSET)
OBJECTS += $(OBJDIR)/effect_workset.o
$(ELF): $(OBJDIR)/effect_workset.o
-include $(OBJDIR)/effect_workset.d
ifeq ($(N23_NATIVE_ARM),1)
$(OBJDIR)/collision.o $(OBJDIR)/ai.o $(OBJDIR)/time.o: ARCH := -marm -mcpu=arm946e-s+nofp
endif

N23_MAP_FLOOR_RUNS ?= 0
CPPFLAGS += -DN23_MAP_FLOOR_RUNS=$(N23_MAP_FLOOR_RUNS)
PLATFORM_CPPFLAGS += -DN23_MAP_FLOOR_RUNS=$(N23_MAP_FLOOR_RUNS)
