# N07 independent hardware 3D renderer; accepted N03-N06 sources are read-only.
BLOCKSDS ?= /opt/blocksds/core
WONDERFUL_TOOLCHAIN ?= /opt/wonderful
ARM_NONE_EABI_PATH ?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/
ARM7ELF ?= $(BLOCKSDS)/sys/arm7/main_core/arm7_maxmod.elf
OUTDIR := ../../build/nds/n12
OBJDIR := $(OUTDIR)/obj
NAME := dok_nds_sprites
ELF := $(OUTDIR)/$(NAME).elf
MAP := $(OUTDIR)/$(NAME).map
ROM := $(OUTDIR)/$(NAME).nds
OBJECTS := $(addprefix $(OBJDIR)/,main.o sprites.o sprite_assets.o texture_cache.o render_backend.o scene.o materials.o geometry.o assets.o memory.o sha256.o world.o balance.o file_reader.o)
CHECK_OBJECTS :=
CC := $(ARM_NONE_EABI_PATH)arm-none-eabi-gcc
NDSTOOL := $(BLOCKSDS)/tools/ndstool/ndstool
ARCH := -mthumb -mcpu=arm946e-s+nofp
# Fixed-point scene/GE math uses ARM's native long multiply instructions.
# Loader, shell and accepted core modules retain their original Thumb build.
RENDER_ARCH ?= -marm
SPRITE_LANGUAGE ?= 1
SPRITE_AUDIT ?= 0
SPECS := $(BLOCKSDS)/sys/crts/ds_arm9.specs
CPPFLAGS := -D__NDS__ -D__BLOCKSDS__ -DARM9 -Iinclude -DSPRITE_LANGUAGE=$(SPRITE_LANGUAGE) -DSPRITE_AUDIT=$(SPRITE_AUDIT) -Iplatform/assets -Iplatform/render_probe -Iplatform/sprites_probe -I$(OUTDIR)/generated
CFLAGS := -O2 -g3 -Wall -Wextra -Werror -ffunction-sections -fdata-sections -fstack-usage
CORE_CFLAGS := -std=c11 -pedantic-errors $(CFLAGS)
PLATFORM_CPPFLAGS := $(CPPFLAGS) -I$(BLOCKSDS)/libs/libnds/include
LDFLAGS := -L$(BLOCKSDS)/libs/libnds/lib -Wl,-Map,$(MAP) -Wl,--defsym=__usr_stack_size=12288
.PHONY: all backend-check geometry-gate
all: $(ROM) $(CHECK_OBJECTS)
backend-check: $(OBJDIR)/render_backend.o
geometry-gate: $(OUTDIR)/dok_nds_geometry.nds
$(OUTDIR)/dok_nds_geometry.nds: $(OUTDIR)/dok_nds_geometry.elf $(ARM7ELF)
	"$(NDSTOOL)" -c "$@" -9 "$<" -7 "$(ARM7ELF)"
$(OUTDIR)/dok_nds_geometry.elf: $(OBJDIR)/geometry_gate.o $(OBJDIR)/render_backend.o
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) -o "$@" $^ -L$(BLOCKSDS)/libs/libnds/lib -Wl,-Map,$(OUTDIR)/dok_nds_geometry.map -Wl,--defsym=__usr_stack_size=12288 -Wl,--start-group -lnds9 -lc -Wl,--end-group
$(OBJDIR)/geometry_gate.o: platform/render_probe/geometry_gate.c platform/render_probe/render_probe.h Makefile.n12 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(PLATFORM_CPPFLAGS) -std=gnu11 $(CFLAGS) -MMD -MP -c "$<" -o "$@"
$(ROM): $(ELF) $(ARM7ELF)
	"$(NDSTOOL)" -c "$@" -9 "$(ELF)" -7 "$(ARM7ELF)"
$(ELF): $(OBJECTS)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) -o "$@" $(OBJECTS) $(LDFLAGS) -Wl,--start-group -lnds9 -lc -Wl,--end-group
$(OBJDIR)/main.o: platform/sprites_probe/main.c platform/render_probe/render_probe.h platform/sprites_probe/sprites_probe.h Makefile.n12 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(PLATFORM_CPPFLAGS) -std=gnu11 $(CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/render_backend.o: platform/render_probe/render_backend.c platform/render_probe/render_backend.h Makefile.n12 | $(OBJDIR)
	"$(CC)" $(RENDER_ARCH) -mcpu=arm946e-s+nofp -specs=$(SPECS) $(PLATFORM_CPPFLAGS) -std=gnu11 $(CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/scene.o: render/scene.c Makefile.n12 | $(OBJDIR)
	"$(CC)" $(RENDER_ARCH) -mcpu=arm946e-s+nofp -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/geometry.o: render/geometry.c Makefile.n12 | $(OBJDIR)
	"$(CC)" $(RENDER_ARCH) -mcpu=arm946e-s+nofp -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/file_reader.o: platform/assets/file_reader.c Makefile.n12 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(PLATFORM_CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/%.o: render/%.c Makefile.n12 | $(OBJDIR)
	"$(CC)" $(RENDER_ARCH) -mcpu=arm946e-s+nofp -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/%.o: core/%.c Makefile.n12 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR)/%.o: tests/%.c Makefile.n12 | $(OBJDIR)
	"$(CC)" $(ARCH) -specs=$(SPECS) $(CPPFLAGS) $(CORE_CFLAGS) -MMD -MP -c "$<" -o "$@"
$(OBJDIR):
	mkdir -p "$@"
-include $(OBJECTS:.o=.d) $(CHECK_OBJECTS:.o=.d)
