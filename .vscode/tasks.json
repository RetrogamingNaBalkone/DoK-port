{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DoK: build and test C modules",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-native.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "DoK: build GBA diagnostic",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-gba.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "DoK: build and verify bilingual GBA asset ROM",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-gba-assets.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "DoK: build and verify LEVEL1 GBA renderer",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-gba-renderer.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "DoK: build and verify GBA diagnostic",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-gba.ps1", "-Verify"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    }
  ]
}
